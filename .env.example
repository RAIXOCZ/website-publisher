# --- Required -------------------------------------------------------------
# E-mail (confirmation and sign-in links) is sent through Resend
# (https://resend.com, free tier 3,000 e-mails/month). Verify your domain in
# Resend first. Without a key no e-mails go out and nobody can publish
# (except from IP_WHITELIST addresses).
RESEND_API_KEY=
# Sender address; must be on the domain verified in Resend.
MAIL_FROM=Freepages <noreply@freepages.dev>

# --- Addresses ------------------------------------------------------------
# Where the publisher itself is reachable (as the browser sees it).
PUBLIC_URL=https://freepages.dev

# Each site is published on its own subdomain, https://<name>.<SITE_DOMAIN>/
# (needs a wildcard DNS record + tunnel hostname, see README).
# Leave empty to publish sites as PUBLIC_URL/<name>/ instead.
SITE_DOMAIN=freepages.dev

# --- Optional -------------------------------------------------------------
# How many uploads one IP address may make per hour (admin is not limited).
PUBLISH_PER_HOUR=60

# Upload size limit. Cloudflare Free/Pro rejects requests over 100 MB.
MAX_UPLOAD_MB=100

# The administrator account: signs in to /admin with an e-mail link (no password).
# It is created on start; sites published before accounts existed belong to it.
ADMIN_EMAIL=martin@freepages.dev

# IP addresses that may publish without an account, with per-site passwords
# (comma separated). More can be added in the admin panel.
IP_WHITELIST=

# Host port for docker-compose.local.yml (not used on Dokploy).
HOST_PORT=3000

# Only needed for the bundled cloudflared service (docker compose --profile tunnel up).
TUNNEL_TOKEN=
