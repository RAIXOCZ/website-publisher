# --- Required -------------------------------------------------------------
# Password for publishing and the admin panel (/admin).
ADMIN_PASSWORD=change-me-to-something-long

# --- Addresses ------------------------------------------------------------
# Where the publisher itself is reachable (as the browser sees it).
PUBLIC_URL=https://pub.raixo.org

# Each site is published on its own subdomain, https://<name>.<SITE_DOMAIN>/
# (needs a wildcard DNS record + tunnel hostname, see README).
# Leave empty to publish sites as https://pub.raixo.org/<name>/ instead.
SITE_DOMAIN=freepages.dev

# --- Optional -------------------------------------------------------------
# Let anyone upload without logging in (they can't replace existing sites).
PUBLIC_UPLOAD=false

# Upload size limit. Cloudflare Free/Pro rejects requests over 100 MB.
MAX_UPLOAD_MB=100

# Host port for the plain docker-compose.yml.
HOST_PORT=3000

# Only needed for the bundled cloudflared service (docker compose --profile tunnel up).
TUNNEL_TOKEN=
