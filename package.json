{
  "name": "website-publisher",
  "version": "1.0.0",
  "description": "Drop a folder, get a website. Self-hosted static site publisher.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "ADMIN_PASSWORD=dev DATA_DIR=./data MAIL_DEV_OUTBOX=1 node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
